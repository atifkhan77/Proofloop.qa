# Database
DATABASE_URL="postgresql://proofloop_admin:proofloop_password@localhost:5433/proofloop_qa?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6380"

# Authentication
JWT_SECRET="generate-a-secure-random-string-here"
SESSION_EXPIRATION="7d"

# AI Provider (Optional): openai | anthropic | local
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"            # model for Playwright script generation (OpenAI-compatible /chat/completions)

# Automation worker sandbox (apps/worker/src/sandbox.ts). Requires Docker on the worker host.
# Default image. Repositories get the official image matching the Playwright version in their
# lockfile (pulled once per version, then cached), so browsers are never downloaded per run.
PLAYWRIGHT_IMAGE="mcr.microsoft.com/playwright:v1.64.1-noble"
PLAYWRIGHT_VERSION="1.64.1"       # @playwright/test matching PLAYWRIGHT_IMAGE
IMAGE_PULL_TIMEOUT_MS=900000      # first pull of a version-matched image (not counted in RUN_TIMEOUT_MS)
RUN_TIMEOUT_MS=1200000            # kill a run after 20 min
WORKER_CONCURRENCY=1              # parallel runs (each is one container)
SANDBOX_MEMORY="4g"
SANDBOX_CPUS="2"

# Frontend & Backend URLs
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
VITE_API_URL="http://localhost:4000/api"
PORT=4000

# API hardening / scaling (see docs/ISSUE-LOG.md section 13)
NODE_ENV="development"            # "production" disables dev-only behaviour (reset-link logging, loopback sign-up exemption)
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS=""                   # comma-separated browser origins; empty = FRONTEND_URL / Vite dev server
WEB_CONCURRENCY=1                 # API processes for `npm start -w @proofloop/api` (cluster mode)
